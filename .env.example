# Copy to .env (or run `python -m copilot init`, which also generates SERVER_TOKEN).
# Run `python -m copilot doctor` at any time to see what is still missing.

# --- Who you are -------------------------------------------------------------
# Your display name EXACTLY as it appears in your WhatsApp .txt exports
# ("12/31/23, 9:15 PM - <this name>: ..."). Used to tell your messages apart.
MY_NAME=

# --- Local server --------------------------------------------------------------
# Shared secret between the Chrome extension and the local server. Any web page
# can reach 127.0.0.1, so the server refuses requests without this token.
SERVER_TOKEN=
HOST=127.0.0.1
PORT=8765

# --- LLM providers (tried in this order; unconfigured ones are skipped) ---------
LLM_PROVIDERS=groq,gemini,ollama

# Groq — free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama — fully local, no key: https://ollama.com  (then `ollama pull llama3.2:3b`)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# --- Retrieval -------------------------------------------------------------------
# Any fastembed model: https://qdrant.github.io/fastembed/examples/Supported_Models/
# Use a multilingual one (e.g. intfloat/multilingual-e5-large) if you don't chat in English.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# How many of your past replies are shown to the LLM as style examples.
EXAMPLES_K=12
